"""Unit tests for rules_engine.py - run with:  pytest -q test_rules.py"""
import copy
import re
from pathlib import Path

import pytest

import rules_engine as re_mod
from rules_engine import (
    BeamMinDepthRule,
    ColumnAspectRatioRule,
    ColumnMinRebarRule,
    ConcreteCoverRule,
    FoundationBearingRule,
    LongSpanWithoutMidSupportRule,
    OrphanColumnReferenceRule,
    RulesEngine,
    ShearWallCountRule,
    Violation,
)

ARABIC_TEMPLATE = re.compile(r"^.+ \S+ في الطابق \d+: .+ — القيمة الفعلية .+، الحد المطلوب .+\.$")


def _col(cid, x, y, floor=1):
    return dict(id=cid, floor=floor, x=x, y=y, width_mm=500, depth_mm=500,
                rebar_ratio=0.015, concrete_cover_mm=45)


def _beam(bid, s, e, direction="X", span=6.0):
    return dict(id=bid, floor=1, direction=direction, start_column=s, end_column=e,
                span_m=span, width_mm=300, depth_mm=500, mid_support=False,
                concrete_cover_mm=45)


@pytest.fixture
def model():
    """Small, fully compliant in-memory model (0 violations for every rule)."""
    return {
        "project": {"seismic_zone": 3},
        "columns": [_col("C-001", 0, 0), _col("C-002", 6, 0), _col("C-003", 0, 5), _col("C-004", 6, 5)],
        "beams": [_beam("B-001", "C-001", "C-002"), _beam("B-002", "C-003", "C-004")],
        "walls": [
            dict(id="W-1", floor=1, type="shear", direction="X", length_m=5, thickness_mm=250),
            dict(id="W-2", floor=1, type="shear", direction="X", length_m=5, thickness_mm=250),
            dict(id="W-3", floor=1, type="shear", direction="Y", length_m=5, thickness_mm=250),
            dict(id="W-4", floor=1, type="shear", direction="Y", length_m=5, thickness_mm=250),
        ],
        "foundations": [
            dict(id=f"F-{i}", column_id=f"C-00{i}", floor=0, type="isolated_footing",
                 area_m2=10.0, load_kN=2000, bearing_capacity_kPa=300)
            for i in range(1, 5)
        ],
    }


def test_clean_model_has_no_violations(model):
    assert RulesEngine.default().run(model) == []


def test_rule1_orphan_column_reference(model):
    model["beams"][0]["end_column"] = "C-999"
    violations = OrphanColumnReferenceRule().validate(model)
    assert len(violations) == 1
    assert violations[0].severity == "CRITICAL" and violations[0].element_id == "B-001"
    assert "(X=6.0, Y=0.0)" in violations[0].suggested_fix_ar


def test_rule2_long_span_without_mid_support(model):
    model["beams"][0]["span_m"] = 13.0
    assert len(LongSpanWithoutMidSupportRule().validate(model)) == 1
    model["beams"][0]["mid_support"] = True
    assert len(LongSpanWithoutMidSupportRule().validate(model)) == 0


def test_rule3_column_min_rebar(model):
    model["columns"][0]["rebar_ratio"] = 0.008
    model["columns"][1]["rebar_ratio"] = 0.009
    violations = ColumnMinRebarRule().validate(model)
    assert len(violations) == 2
    assert violations[0].message_ar == (
        "العمود C-001 في الطابق 1: نسبة تسليح أقل من الحد الأدنى للمنطقة الزلزالية 3 "
        "— القيمة الفعلية 0.008، الحد المطلوب 0.010.")


def test_rule4_column_aspect_ratio(model):
    model["columns"][2].update(width_mm=250, depth_mm=700)  # ratio 0.357
    assert len(ColumnAspectRatioRule().validate(model)) == 1


def test_rule5_foundation_bearing_capacity(model):
    model["foundations"][3].update(area_m2=5.0, load_kN=2000)  # 400 kPa > 300 kPa
    violations = FoundationBearingRule().validate(model)
    assert len(violations) == 1 and violations[0].element_id == "F-4"
    assert "6.7" in violations[0].suggested_fix_ar


def test_rule6_beam_min_depth(model):
    model["beams"][0]["depth_mm"] = 350  # required 375 for a 6.0 m span
    model["beams"][1]["depth_mm"] = 300
    assert len(BeamMinDepthRule().validate(model)) == 2


def test_rule7_shear_wall_count(model):
    model["walls"] = [w for w in model["walls"] if not (w["direction"] == "X" and w["id"] == "W-2")]
    violations = ShearWallCountRule().validate(model)
    assert len(violations) == 1
    assert violations[0].element_id == "LFRS-F1-X"


def test_rule8_concrete_cover(model):
    model["columns"][0]["concrete_cover_mm"] = 30
    model["beams"][1]["concrete_cover_mm"] = 25
    model["beams"][0]["concrete_cover_mm"] = 40  # exactly at the limit -> compliant
    assert len(ConcreteCoverRule().validate(model)) == 2


def test_rule8_missing_cover_is_an_error_not_a_silent_default(model):
    del model["columns"][0]["concrete_cover_mm"]
    with pytest.raises(ValueError):
        ConcreteCoverRule().validate(model)


def test_engine_sorts_critical_then_high_then_medium(model):
    model["beams"][0]["depth_mm"] = 350
    model["columns"][0]["rebar_ratio"] = 0.005
    model["beams"][1]["span_m"] = 13.0
    severities = [v.severity for v in RulesEngine.default().run(model)]
    assert severities == sorted(severities, key=lambda s: {"CRITICAL": 0, "HIGH": 1, "MEDIUM": 2}[s])
    assert severities[0] == "CRITICAL" and severities[-1] == "MEDIUM"


def test_sample_model_has_exact_injected_violations():
    import json
    sample = json.loads((Path(__file__).with_name("sample_model.json")).read_text(encoding="utf-8"))
    assert len(sample["columns"]) >= 24 and len(sample["beams"]) >= 30
    assert len(sample["walls"]) >= 6 and len(sample["foundations"]) >= 20
    assert sum(w["type"] == "shear" for w in sample["walls"]) >= 4
    violations = RulesEngine.default().run(sample)
    by_rule = {}
    for v in violations:
        by_rule[v.rule_id] = by_rule.get(v.rule_id, 0) + 1
    assert by_rule == {1: 1, 2: 1, 3: 2, 4: 1, 5: 1, 6: 2, 7: 1, 8: 3}
    assert len(violations) == 12
    for v in violations:
        assert ARABIC_TEMPLATE.match(v.message_ar), v.message_ar
        assert v.suggested_fix_ar and v.suggested_fix_en and isinstance(v, Violation)


