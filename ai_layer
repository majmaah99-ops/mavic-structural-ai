_ONLINE_DISABLED: bool = False
_WARNED: bool = False


def clear_cache() -> None:
    """مسح الذاكرة المؤقتة وإعادة تفعيل الوضع المتصل."""
    global _ONLINE_DISABLED, _WARNED
    _CACHE.clear()
    _ONLINE_DISABLED = False
    _WARNED = False


def cache_key(violation: Violation) -> str:
    """مفتاح الذاكرة المؤقتة."""
    return f"{violation.rule_id}:{violation.element_id}:{violation.message_ar[:50]}"


def _warn_once(message: str) -> None:
    """تسجيل تحذير واحد فقط ثم تعطيل الوضع المتصل."""
    global _ONLINE_DISABLED, _WARNED
    _ONLINE_DISABLED = True
    if not _WARNED:
        _WARNED = True
        logger.warning("AI layer: falling back to OFFLINE mode (%s)", message)


