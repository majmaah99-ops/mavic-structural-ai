def _offline_suggestion(violation: Violation) -> dict[str, Any]:
    """اقتراح غير متصل من القاموس المدمج."""
    base = OFFLINE_SUGGESTIONS.get(violation.rule_id, _GENERIC_SUGGESTION)
    result = copy.deepcopy(base)
    result["source"] = "offline"
    return result


_LFRS_ID = re.compile(r"^LFRS-F(\d+)-([XY])$")


def _dist2(a: dict[str, Any], b: dict[str, Any]) -> float:
    return (float(a["x"]) - float(b["x"])) ** 2 + (float(a["y"]) - float(b["y"])) ** 2


def _resolve_element(violation: Violation, model: dict[str, Any]) -> tuple[str | None, dict[str, Any]]:
    """إيجاد العنصر المخالف في النموذج."""
    for key in ("columns", "beams", "walls", "foundations"):
        for el in model.get(key, []):
            if el.get("id") == violation.element_id:
                return key, el
    match = _LFRS_ID.match(violation.element_id)
    if match:
        floor, direction = int(match.group(1)), match.group(2)
        count = sum(
            1 for w in model.get("walls", [])
            if w.get("floor") == floor and w.get("type") == "shear"
            and str(w.get("direction", "")).upper() == direction)
        return "lfrs", {"floor": floor, "direction": direction, "shear_walls_in_direction": count}
    return None, {}


def _context_elements(kind: str | None, element: dict[str, Any], model: dict[str, Any]) -> list[dict[str, Any]]:
    """2-3 عناصر سياقية ذات صلة."""
    columns = {c["id"]: c for c in model.get("columns", [])}
    ctx: list[dict[str, Any]] = []

    if kind == "beams":
        connected = {element.get("start_column"), element.get("end_column")}
        for ref in (element.get("start_column"), element.get("end_column")):
            if ref in columns:
                ctx.append({"kind": "column", **columns[ref]})
                break
        siblings = [b for b in model.get("beams", [])
                    if b["id"] != element["id"] and b.get("floor") == element.get("floor")]
        siblings.sort(key=lambda b: (
            0 if {b.get("start_column"), b.get("end_column")} & connected else 1,
            0 if b.get("direction") == element.get("direction") else 1,
            b["id"]))
        ctx += [{"kind": "beam", **b} for b in siblings[:2]]
    elif kind == "columns":
        same_floor = [c for c in model.get("columns", [])
                      if c["id"] != element["id"] and c.get("floor") == element.get("floor")]
        same_floor.sort(key=lambda c: _dist2(c, element))
        ctx += [{"kind": "column", **c} for c in same_floor[:3]]
    elif kind == "foundations":
        supported = columns.get(element.get("column_id"))
        if supported:
            ctx.append({"kind": "column", **supported})
        others = [f for f in model.get("foundations", []) if f["id"] != element["id"]]
        if supported:
            others.sort(key=lambda f: _dist2(columns[f["column_id"]], supported)
                        if f.get("column_id") in columns else float("inf"))
        ctx += [{"kind": "foundation", **f} for f in others[:2]]
    elif kind == "walls":
        others = [w for w in model.get("walls", [])
                  if w["id"] != element["id"] and w.get("floor") == element.get("floor")]
        others.sort(key=lambda w: (w.get("type") != element.get("type"), w["id"]))
        ctx += [{"kind": "wall", **w} for w in others[:3]]
    elif kind == "lfrs":
        walls = [w for w in model.get("walls", [])
                 if w.get("floor") == element["floor"] and w.get("type") == "shear"]
        walls.sort(key=lambda w: (str(w.get("direction", "")).upper() != element["direction"], w["id"]))
        ctx += [{"kind": "wall", **w} for w in walls[:3]]

    return ctx[:3]


def _build_prompt(violation: Violation, model: dict[str, Any]) -> list[dict[str, str]]:
    """بناء رسائل المحادثة."""
    kind, element = _resolve_element(violation, model)
    payload = {
        "rule_id": violation.rule_id,
        "severity": violation.severity,
        "message_ar": violation.message_ar,
        "sbc_reference": violation.sbc_reference,
        "seismic_zone": model.get("project", {}).get("seismic_zone"),
        "element": element,
        "context": _context_elements(kind, element, model),
    }
    system = (
        "أنت مهندس إنشائي استشاري في السعودية. أجب بالعربية وبصيغة JSON فقط دون أي نص إضافي، "
        "بالمفاتيح التالية بالضبط: "
        '{"root_cause_ar": str, "fix_steps_ar": [str, str, str], '
        '"estimated_cost_impact_ar": str, "priority_ar": str}. '
        "اجعل كل حقل موجزاً جداً (جملة واحدة قصيرة، أقل من 20 كلمة) وحدد خطوات الإصلاح الثلاث بدقة."
    )
    user = json.dumps(payload, ensure_ascii=False, separators=(",", ":"))
    return [{"role": "system", "content": system}, {"role": "user", "content": user}]


def _parse_response(text: str) -> dict[str, Any]:
    """تحليل رد النموذج والتحقق من بنيته."""
    cleaned = text.strip()
    cleaned = re.sub(r"^```(?:json)?\s*|\s*```$", "", cleaned)
    data = json.loads(cleaned)
    if not isinstance(data, dict):
        raise ValueError("reply is not a JSON object")
    for key in ("root_cause_ar", "estimated_cost_impact_ar", "priority_ar"):
        if not isinstance(data.get(key), str) or not data[key].strip():
            raise ValueError(f"missing or invalid '{key}'")
    steps = data.get("fix_steps_ar")
    if not isinstance(steps, list) or len(steps) < 3 or not all(isinstance(s, str) and s.strip() for s in steps):
        raise ValueError("'fix_steps_ar' must be a list of 3 non-empty strings")
    return {
        "root_cause_ar": data["root_cause_ar"].strip(),
        "fix_steps_ar": [s.strip() for s in steps[:3]],
        "estimated_cost_impact_ar": data["estimated_cost_impact_ar"].strip(),
        "priority_ar": data["priority_ar"].strip(),
        "source": "online",
    }


def _call_openai(violation: Violation, model: dict[str, Any]) -> dict[str, Any]:
    """استدعاء gpt-4o-mini."""
    if _openai is None:
        raise ImportError("the 'openai' package is not installed")
    client = _openai.OpenAI(api_key=os.environ["OPENAI_API_KEY"], timeout=OPENAI_TIMEOUT_S, max_retries=0)
    response = client.chat.completions.create(
        model=OPENAI_MODEL,
        temperature=OPENAI_TEMPERATURE,
        max_tokens=OPENAI_MAX_TOKENS,
        response_format={"type": "json_object"},
        messages=_build_prompt(violation, model),
    )
    return _parse_response(response.choices[0].message.content or "")


def enhance_violation(violation: Violation, model: dict) -> dict:
    """
    إثراء مخالفة واحدة بتوصية هندسية.
    يرجع قاموساً بالمفاتيح: root_cause_ar, fix_steps_ar (3 خطوات),
    estimated_cost_impact_ar, priority_ar, source ("online" | "offline").
    لا يرفع أي استثناء أبداً؛ عند أي فشل يعود للوضع غير المتصل.
    """
    key = cache_key(violation)
    if key in _CACHE:
        return copy.deepcopy(_CACHE[key])

    if os.environ.get("OPENAI_API_KEY") and not _ONLINE_DISABLED:
        try:
            result = _call_openai(violation, model)
            _CACHE[key] = result
            return copy.deepcopy(result)
        except Exception as exc:
            _warn_once(f"{type(exc).__name__}: {exc}")

    return _offline_suggestion(violation)


def _violation_dict(violation: Violation) -> dict[str, Any]:
    """تحويل المخالفة إلى قاموس (pydantic v2/v1)."""
    if hasattr(violation, "model_dump"):
        return violation.model_dump()
    return violation.dict()


def enhance_all(violations: list[Violation], model: dict) -> list[dict]:
    """
    إثراء كل المخالفات؛ كل عنصر في القائمة يجمع حقول المخالفة الأصلية مع الحقول المحسّنة.
    """
    return [{**_violation_dict(v), **enhance_violation(v, model)} for v in violations]


_SEVERITY_AR = {"CRITICAL": "حرجة", "HIGH": "عالية", "MEDIUM": "متوسطة"}


def format_enriched(items: list[dict[str, Any]]) -> str:
    """تنسيق النتائج بصيغة عربية مقروءة."""
    counts = {s: sum(1 for i in items if i["severity"] == s) for s in _SEVERITY_AR}
    modes = {i.get("source", "offline") for i in items}
    lines = [
        "=" * 72,
        f"تقرير المخالفات المُحسَّن - الإجمالي: {len(items)} | "
        + " | ".join(f"{_SEVERITY_AR[s]}: {n}" for s, n in counts.items()),
        f"وضع التحسين: {'متصل (OpenAI)' if modes == {'online'} else 'غير متصل (قاموس مدمج)' if modes == {'offline'} else 'مختلط'}",
        "=" * 72,
    ]
    for n, i in enumerate(items, 1):
        lines += [
            "",
            f"[{n}] ({_SEVERITY_AR.get(i['severity'], i['severity'])}) القاعدة {i['rule_id']} - {i['element_type']} {i['element_id']}",
            f"  المخالفة      : {i['message_ar']}",
            f"  المرجع        : {i['sbc_reference']}",
            f"  السبب الجذري  : {i['root_cause_ar']}",
            "  خطوات الإصلاح :",
            *[f"    {k}. {step}" for k, step in enumerate(i["fix_steps_ar"], 1)],
            f"  أثر التكلفة   : {i['estimated_cost_impact_ar']}",
            f"  الأولوية      : {i['priority_ar']}",
        ]
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    """نقطة الدخول: python ai_layer.py sample_model.json"""
    logging.basicConfig(level=logging.WARNING, format="%(levelname)s: %(message)s")
    argv = sys.argv[1:] if argv is None else argv
    path = Path(argv[0]) if argv else Path(__file__).with_name("sample_model.json")
    model = load_model(path)
    violations = RulesEngine.default().run(model)
    print(format_enriched(enhance_all(violations, model)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
